{
  "name": "watchroom",
  "productName": "Watchroom",
  "version": "1.0.7",
  "description": "Watch together. Share a screen or window with family and friends, with voice and chat.",
  "private": true,
  "watchroomRelayUrl": "wss://watchroom-relay.peterndrio.workers.dev",
  "watchroomTurnUrl": "https://watchroom-turn.peterndrio.workers.dev",
  "watchroomTurn": [],
  "watchroomUpdates": {
    "owner": "petern22",
    "repo": "watchroom"
  },
  "main": "main.js",
  "scripts": {
    "build": "esbuild renderer/app.js --bundle --format=iife --target=chrome120 --minify --outfile=renderer/bundle.js && esbuild renderer/hearts.js --bundle --format=iife --target=chrome120 --minify --outfile=renderer/hearts-bundle.js",
    "start": "npm run build && electron .",
    "test": "node test/meters.test.mjs && node test/room-policy.test.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/room-lifecycle.test.mjs && node test/extras.test.mjs && node test/relay.test.mjs && node test/updates.test.mjs",
    "build:web": "node scripts/build-web.mjs",
    "deploy:web": "npm run build:web && npx wrangler deploy --config pwa/wrangler.toml",
    "dist": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "local.watchroom",
    "productName": "Watchroom",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "protocols": [
      {
        "name": "Watchroom",
        "schemes": [
          "watchroom"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "updates.js",
      "renderer/index.html",
      "renderer/styles.css",
      "renderer/bundle.js",
      "renderer/hearts.html",
      "renderer/alert.html",
      "renderer/alert.js",
      "renderer/hearts-bundle.js"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Watchroom uses your microphone so people in the room can hear you.",
        "NSScreenCaptureUsageDescription": "Watchroom shares the screen or window you choose with the people in your room."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "trystero": "^0.26.0"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  }
}
